{
  "name": "@trevorrecker/skctl",
  "version": "0.5.0",
  "type": "module",
  "description": "Manage portable agent skills, commands, and instructions across Claude Code, Codex, OpenCode, and Cursor",
  "keywords": [
    "skills",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "raycast",
    "cli"
  ],
  "homepage": "https://github.com/trevorrecker/skctl#readme",
  "bugs": {
    "url": "https://github.com/trevorrecker/skctl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevorrecker/skctl.git"
  },
  "license": "MIT",
  "author": "Trevor Recker",
  "bin": {
    "skctl": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "raycast/README.md",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "engines": {
    "node": "^22.13 || ^24 || >=26"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc --watch",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
